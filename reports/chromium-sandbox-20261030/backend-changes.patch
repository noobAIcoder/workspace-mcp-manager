+def write_mapping(process, ns, leaf, value, notification, listener):
+    # Linux's unprivileged single-ID mapping rule requires the writer to be in
+    # the target's immediate parent user namespace. Never move the supervisor:
+    # a fixed-operation helper enters an already validated owned descendant.
+    def perform():
+        valid(listener, notification)
+        target = os.open(leaf, os.O_WRONLY | os.O_CLOEXEC, dir_fd=process)
+        try:
+            valid(listener, notification)
+            return os.write(target, value)
+        finally:
+            os.close(target)
+
+    parent = fcntl.ioctl(ns, 0xb702)  # NS_GET_PARENT; ns was ownership/ancestry checked
+    try:
+        own = os.open('/proc/self/ns/user', os.O_RDONLY | os.O_CLOEXEC)
+        try:
+            direct = namespace_identity(parent) == namespace_identity(own)
+        finally:
+            os.close(own)
+        if direct:
+            return perform()
+        uid, gid = os.getuid(), os.getgid()
+        reader, writer = os.pipe2(os.O_CLOEXEC)
+        try:
+            valid(listener, notification)
+            child = os.fork()
+        except BaseException:
+            os.close(reader)
+            os.close(writer)
+            raise
+        if child == 0:
+            os.close(reader)
+            error, count = errno.EIO, 0
+            try:
+                if LIBC.setns(parent, 0x10000000):
+                    raise OSError(C.get_errno(), 'cannot enter owned parent user namespace')
+                if os.getuid() != uid or os.getgid() != gid:
+                    raise PermissionError(errno.EACCES, 'namespace would change helper identity')
+                count = perform()
+                error = 0
+            except OSError as exc:
+                error = exc.errno or errno.EIO
+            finally:
+                os.write(writer, struct.pack('=ii', error, count))
+                os._exit(0)
+        os.close(writer)
+        try:
+            poller = select.poll()
+            poller.register(reader, select.POLLIN | select.POLLHUP)
+            if not poller.poll(5000):
+                os.kill(child, signal.SIGKILL)
+                raise OSError(errno.ETIMEDOUT, 'namespace helper timed out')
+            payload = os.read(reader, 8)
+            if len(payload) != 8:
+                raise OSError(errno.EIO, 'namespace helper failed')
+            error, count = struct.unpack('=ii', payload)
+            if error:
+                raise OSError(error, 'namespace helper refused mapping')
+            return count
+        finally:
+            os.close(reader)
+            os.waitpid(child, 0)
+    finally:
+        os.close(parent)
