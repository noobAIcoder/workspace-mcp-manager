+    def test_proc_directory_anchor_and_self_fd_listing(self):
+        self.python('''import os,fcntl,ctypes
+anchor=os.open('/proc/',os.O_RDONLY|os.O_DIRECTORY|os.O_CLOEXEC)
+assert fcntl.fcntl(anchor,fcntl.F_GETFD)&fcntl.FD_CLOEXEC
+assert 'self' in os.listdir(anchor)
+assert os.stat('self/task/',dir_fd=anchor).st_nlink>=3
+fds=ctypes.CDLL(None).openat(anchor,b'self/fd/',os.O_RDONLY|os.O_DIRECTORY)
+assert fds>=0
+assert not fcntl.fcntl(fds,fcntl.F_GETFD)&fcntl.FD_CLOEXEC
+assert str(anchor) in os.listdir(fds)
+os.close(fds)
+for p in ['self/environ','self/mem','1/stat','1/maps',f'self/fd/{anchor}','self/fdinfo/0']:
+ try: os.open(p,os.O_RDONLY,dir_fd=anchor); raise AssertionError(p)
+ except PermissionError: pass
+os.close(anchor)
+''')
+
+    def test_inherited_anchor_resolves_child_fd_directory(self):
+        self.python('''import os
+anchor=os.open('/proc/',os.O_RDONLY|os.O_DIRECTORY)
+child=os.fork()
+if child==0:
+ r,w=os.pipe()
+ fds=os.open('self/fd/',os.O_RDONLY|os.O_DIRECTORY,dir_fd=anchor)
+ assert str(w) in os.listdir(fds)
+ assert os.fstat(fds).st_ino==os.stat('/proc/self/fd').st_ino
+ os._exit(0)
+assert os.waitpid(child,0)[1]==0
+os.close(anchor)
+''')
+
+    def test_proc_anchor_can_be_reopened_without_proc_subtree_access(self):
+        self.python('''import os
+anchor=os.open('/proc/',os.O_RDONLY|os.O_DIRECTORY)
+copy=os.open('.',os.O_RDONLY|os.O_DIRECTORY,dir_fd=anchor)
+assert os.fstat(copy).st_ino==os.fstat(anchor).st_ino
+assert os.stat('self/task/',dir_fd=copy).st_nlink==3
