+@contextmanager
+def process_identity(tid):
+    task = os.open(f'/proc/{tid}', os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
+    process = None
+    try:
+        with os.fdopen(os.open('status', os.O_RDONLY | os.O_CLOEXEC, dir_fd=task), 'rb') as stream:
+            status = dict(line.split(b':', 1) for line in stream if b':' in line)
