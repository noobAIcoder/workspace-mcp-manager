+def proc_directory(notification, listener, leaf=None):
+    flags = read_flags(notification)
+    safe = os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK | 0x8000
+    if flags & ~safe or not flags & os.O_DIRECTORY:
+        raise PermissionError(errno.EACCES, 'only read-only proc directory opens are permitted')
+    valid(listener, notification)
+    if leaf is None:
+        # This grants directory entries only, never a Landlock subtree rule.
+        fd = os.open('/proc', os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
+        try:
+            valid(listener, notification)
+            ioctl(listener, ADDFD, AddFD(notification.id, 2, fd, 0, flags & os.O_CLOEXEC))
+        finally:
+            os.close(fd)
+    else:
+        # Resolve self anew even when the caller inherited its proc anchor.
+        with process_identity(notification.pid) as (process, _):
+            fd = os.open(leaf, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC, dir_fd=process)
+            try:
+                valid(listener, notification)
+                ioctl(listener, ADDFD, AddFD(notification.id, 2, fd, 0, flags & os.O_CLOEXEC))
+            finally:
+                os.close(fd)
+
