+import os
+import shlex
+import sys
+import unittest
+
+from tests.compliance import test_proc_stat_broker as baseline
+
+
+class ChromiumProcTests(unittest.TestCase):
+    run_command = baseline.ProcBrokerTests.run_command
+    def python(self, code):
+        result = self.run_command(f'{shlex.quote(sys.executable)} -c {shlex.quote(code)}')
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    def test_maps_direct_and_child(self):
+        self.python('''import os,subprocess,sys
+assert b"python" in open('/proc/self/maps','rb').read()
+subprocess.run([sys.executable,'-c',"assert b'python' in open('/proc/self/maps','rb').read()"],check=True)
+for p in ['/proc/1/maps','/proc/self/mem','/proc/self/environ']:
+ try: open(p,'rb'); raise AssertionError(p)
+ except PermissionError: pass
+try: open('/proc/self/maps','wb'); raise AssertionError('maps write')
+except PermissionError: pass
+''')
+
+    def test_identity_mapping_and_invalid_contents(self):
+        self.python('''import ctypes,os
+uid,gid=os.getuid(),os.getgid()
+assert ctypes.CDLL(None).unshare(0x10000000)==0
+for leaf,value in [('setgroups',b'deny'),('uid_map',f'{uid} {uid} 1'.encode()),('gid_map',f'{gid} {gid} 1'.encode())]:
+ fd=os.open('/proc/self/'+leaf,os.O_WRONLY|os.O_CLOEXEC)
+ for wrong in [b'allow',b'0 0 4294967295',b'0 1001 1',b'1000 1000 2']:
+  try: os.write(fd,wrong); raise AssertionError((leaf,wrong))
+  except PermissionError: pass
+ assert os.write(fd,value)==len(value)
+ os.close(fd)
+assert os.getuid()==uid and os.getgid()==gid
+''')
+
+    def test_mapping_original_namespace_denied(self):
+        self.python('''import os
+for leaf in ['setgroups','uid_map','gid_map']:
+ try: os.open('/proc/self/'+leaf,os.O_WRONLY); raise AssertionError(leaf)
+ except PermissionError: pass
+''')
+
+    def test_nested_user_namespaces_preserve_identity(self):
+        self.python('''import ctypes,os
+c=ctypes.CDLL(None)
+u,g=os.getuid(),os.getgid()
+for depth in range(2):
+ assert c.unshare(0x10000000)==0
+ for leaf,value in [('setgroups',b'deny'),('gid_map',f'{g} {g} 1'.encode()),('uid_map',f'{u} {u} 1'.encode())]:
+  fd=os.open('/proc/self/'+leaf,os.O_WRONLY)
+  assert os.write(fd,value)==len(value)
+  os.close(fd)
+ assert os.getuid()==u and os.getgid()==g
+''')
+
+    def test_mapping_handles_sealed_and_bound_to_requesting_process(self):
+        self.python('''import ctypes,os
+assert ctypes.CDLL(None).unshare(0x10000000)==0
+fd=os.open('/proc/self/setgroups',os.O_WRONLY)
+for attempt in [lambda:os.pwrite(fd,b'deny',0), lambda:os.writev(fd,[b'deny']),lambda:os.ftruncate(fd,20)]:
+ try: attempt(); raise AssertionError('unbrokered write allowed')
+ except PermissionError: pass
+child=os.fork()
+if child==0:
+ try: os.write(fd,b'deny')
+ except PermissionError: os._exit(0)
+ os._exit(1)
+assert os.waitpid(child,0)[1]==0
+assert os.write(fd,b'deny')==4
+try: os.write(fd,b'deny'); raise AssertionError('repeated write')
+except PermissionError: pass
+os.close(fd)
+''')
+
+    def test_maps_mutating_flags_and_aliases_denied(self):
+        self.python('''import os
+for flags in [os.O_WRONLY,os.O_RDWR,os.O_RDONLY|os.O_TRUNC,os.O_RDONLY|os.O_CREAT,os.O_PATH]:
+ try: os.open('/proc/self/maps',flags); raise AssertionError(flags)
+ except PermissionError: pass
