+def owned_child_namespace(process):
+    ns = os.open('ns/user', os.O_RDONLY | os.O_CLOEXEC, dir_fd=process)
+    try:
+        own = os.open('/proc/self/ns/user', os.O_RDONLY | os.O_CLOEXEC)
+        try:
+            own_id = namespace_identity(own)
+        finally:
+            os.close(own)
+        if namespace_identity(ns) == own_id:
+            raise PermissionError(errno.EACCES, 'original namespace is not writable')
+        current = os.dup(ns)
+        try:
+            for _ in range(32):
+                owner = array.array('I', [0])
+                fcntl.ioctl(current, 0xb704, owner, True)  # NS_GET_OWNER_UID
+                if owner[0] != os.getuid():
+                    raise PermissionError(errno.EACCES, 'namespace has another owner')
+                parent = fcntl.ioctl(current, 0xb702)  # NS_GET_PARENT
+                os.close(current)
+                current = parent
+                if namespace_identity(current) == own_id:
+                    return ns
+            raise PermissionError(errno.EACCES, 'namespace ancestry exceeds bound')
+        finally:
+            os.close(current)
+    except BaseException:
+        os.close(ns)
