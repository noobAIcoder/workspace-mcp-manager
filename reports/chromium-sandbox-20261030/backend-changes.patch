+        if any(int(v) != expected for key, expected in [(b'Uid', os.getuid()), (b'Gid', os.getgid())]
+               for v in status[key].split()):
+            raise PermissionError(errno.EACCES, 'requesting credentials differ')
+        process = os.open(f'/proc/{tgid}', os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
+        # Pin both objects while the seccomp notification pins the live task.
+        yield process, tgid
+    finally:
+        if process is not None:
+            os.close(process)
+        os.close(task)
