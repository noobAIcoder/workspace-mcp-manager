+def open_mapping(notification, listener, leaf):
+    flags = read_flags(notification)
+    safe = os.O_WRONLY | os.O_CLOEXEC | os.O_NOCTTY | os.O_NOFOLLOW | 0x8000
+    if flags & os.O_ACCMODE != os.O_WRONLY or flags & ~safe:
+        raise PermissionError(errno.EACCES, 'mapping requires plain write-only open')
+    if len(MAPPING_HANDLES) >= MAX_MAPPING_HANDLES:
+        raise OSError(errno.EMFILE, 'mapping handle bound reached')
+    valid(listener, notification)
+    with process_identity(notification.pid) as (process, tgid):
+        ns = owned_child_namespace(process)
+        placeholder = None
+        pinned = None
+        try:
+            # The namespace must still need the requested mapping. Kernel rules
+            # additionally enforce write-once and single-ID mapping semantics.
+            if leaf != 'setgroups':
+                with os.fdopen(os.open(leaf, os.O_RDONLY | os.O_CLOEXEC, dir_fd=process), 'rb') as stream:
